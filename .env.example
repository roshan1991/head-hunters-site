# ==============================================================================
# Head Hunters Environment Variables Template (.env.example)
# Copy this file to .env and fill in your values. Never commit real credentials.
# ==============================================================================

# ── Database (MySQL 8.4+ / InnoDB) ────────────────────────────────────────────
# Single connection string (Primary)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
DATABASE_MIGRATION_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Optional: Individual DB connection parameters (Fallback if DATABASE_URL is omitted)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="your-password"
DB_NAME="head_hunters"

# Database Connection Pool & SSL Settings
DATABASE_POOL_LIMIT="10"
DATABASE_SSL="false"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# ── Server & Application URLs ──────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ── Authentication & Security ──────────────────────────────────────────────────
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
VISITOR_TOKEN_SECRET="visitor-token-secret-at-least-32-chars-long"

# ── Admin Credentials ──────────────────────────────────────────────────────────
# Used by login & seed scripts (npm run db:seed / npm run seed:admin)
ADMIN_EMAIL="admin@headhunters.com.au"
ADMIN_PASSWORD="change-me"

# ── Email Service (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM_ADDRESS="Head Hunters <noreply@headhunters.com.au>"
ADMIN_NOTIFICATION_EMAIL="admin@headhunters.com.au"
EMAIL_TO="hello@headhunters.com.au"

# ── AI & Chat Integrations ────────────────────────────────────────────────────
AI_CHAT_ENABLED="false"
OLLAMA_BASE_URL="http://localhost:11434"
